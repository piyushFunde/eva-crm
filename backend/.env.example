# ==============================================================================
# EVA CRM BACKEND CONFIGURATION
# Copy this file to .env and adjust variables for your deployment.
# ==============================================================================

# Database Settings
# URL format: jdbc:mysql://<host>:<port>/<db_name>?options
DB_URL=jdbc:mysql://localhost:3306/eva_crm?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=newuser
DB_PASSWORD=NewPassword123!

# JWT Token Security Configuration
# Generate a strong, secure 256-bit key (e.g., openssl rand -base64 32)
JWT_SECRET=super-secret-key-replace-this-with-a-real-256bit-base64-encoded-key-in-production-environments-eva-crm-2024

# VAPID Web Push Notifications Keys
# Generate standard keys for PWA push messaging
VAPID_PUBLIC_KEY=BG...
VAPID_PRIVATE_KEY=...
