<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Common Constants -->
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_FILE" value="eva-crm" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender (For Production Hardening) -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE}.log</file>
        
        <!-- Rolling Policy: Time + Size base rollover -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Rollover daily and when file exceeds 10MB -->
            <fileNamePattern>${LOG_DIR}/archived/${LOG_FILE}-%d{yyyy-MM-dd}-%i.log.gz</fileNamePattern>
            <!-- Max file size per log -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Maintain logs for up to 30 days -->
            <maxHistory>30</maxHistory>
            <!-- Total cap of all archived logs -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Dev Profile Logs -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.eva.crm" level="DEBUG" />
    </springProfile>

    <!-- Prod Profile Logs -->
    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="ROLLING_FILE" />
        </root>
        <logger name="com.eva.crm" level="WARN" />
    </springProfile>
</configuration>
